# Wolt Smart Pantry Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (get it from @userinfobot on Telegram)
# Comma-separated list if multiple users
TELEGRAM_ALLOWED_USERS=

# Default Wolt Store venue slug in Tallinn
DEFAULT_STORE=wolt-market-maakri
DEFAULT_CITY=tallinn
DEFAULT_COUNTRY=est

# Daily Morning Menu Schedule
DAILY_MENU_TIME=09:00
TIMEZONE=Europe/Tallinn

# Google Gemini API Key for Multimodal Food Photo Recognition & Visual Inventory Audit
# Obtain a free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
