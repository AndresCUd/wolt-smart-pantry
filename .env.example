# Wolt Smart Pantry Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (get it from @userinfobot on Telegram)
# Leave empty to allow any user (NOT recommended for security)
TELEGRAM_ALLOWED_USERS=

# Default Wolt Store venue slug in Tallinn
DEFAULT_STORE=wolt-market-maakri
DEFAULT_CITY=tallinn
DEFAULT_COUNTRY=est
